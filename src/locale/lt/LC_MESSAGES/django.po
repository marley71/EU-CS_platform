msgid ""
"Evaluated in terms of the quality of the content, methods, or results of the "
"method"
msgstr "Vertinama pagal turinio, metodų ar metodo rezultatų kokybę"

#: eucitizensciencetheme_portugal/templates/moderation_quality_criteria.html:102
#: eucitizensciencetheme_portugal/templates/moderation_quality_criteria.html:199
